# Copier ce fichier en « .env » et adapter. Le .env n'est jamais commité.
# Aucune clé API ne doit figurer dans ce fichier d'exemple.

# --- Application ---
APP_VERSION=0.1.0

# --- Base de données ---
# Correspond au service déclaré dans docker-compose.yml à la racine du dépôt.
DATABASE_URL=postgresql+psycopg://agentscope:agentscope@localhost:5432/agentscope

# --- Fournisseur d'IA ---
# Le choix du fournisseur, du modèle et de son point d'accès se fait ici, jamais dans le
# code. Trois configurations sont documentées :
#
#   Configuration A — Anthropic (distant, nécessite une clé)
#     AI_PROVIDER=anthropic
#     AI_MODEL=claude-opus-5
#     AI_API_KEY=sk-ant-...
#
#   Configuration B — Ollama (local, aucune clé, point d'accès compatible OpenAI)
#     AI_PROVIDER=ollama
#     AI_MODEL=<le modèle téléchargé localement>
#     AI_BASE_URL=http://localhost:11434/v1
#
#   Configuration de test — doublure, aucun appel réseau. C'est la valeur par défaut,
#   pour qu'un clone du dépôt démarre sans aucune clé.
AI_PROVIDER=fake
AI_MODEL=
# AI_BASE_URL=
# AI_API_KEY=

# --- Front ---
# Origines autorisées par CORS, au format JSON.
CORS_ORIGINS=["http://localhost:5173"]
